# Copy to .env and adjust. Defaults match docker-compose.yml.
KAFKA_BROKERS=localhost:19092
KAFKA_PARTITIONS=12

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=pipeline
CLICKHOUSE_DB=logs

INGEST_PORT=8080
INGEST_API_KEYS=dev-key
INGEST_MAX_PENDING=200000

WORKER_BATCH_SIZE=10000
WORKER_FLUSH_MS=1000

QUERY_PORT=8081
LOG_LEVEL=info
